# Camera Configuration (HTTP Digest Authentication over MJPEG stream)
CAMERA_HOST=camera.example.com
CAMERA_PORT=80
CAMERA_STREAM_PATH=/mjpg/video.mjpg
CAMERA_USER=viewer
CAMERA_PASS=supersecret
CAMERA_USE_HTTPS=false
CAMERA_FPS=10
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

# Host Runtime & Service Configuration
APP_PORT=8090
APP_HOST=0.0.0.0
DATA_DIR=data
CAPTURE_DIR=data/captures
DB_PATH=data/bridge.db
LIVE_IMAGE_PATH=data/live.jpg

# Deep Learning Vision (GB10 Blackwell GPU on Spark)
DEVICE=cuda:0
MODEL_PATH=models/yolov8n.pt
CONF_THRESHOLD=0.35
IOU_THRESHOLD=0.50

# Storage & Retention Policy
CAPTURE_MAX_CYCLES=25
CAPTURE_MAX_MB=2048
PRE_EVENT_BUFFER_SECONDS=120

# Frontend Proxy Target (Vercel)
STATS_ORIGIN=https://spark-2079.tail058366.ts.net:8443
